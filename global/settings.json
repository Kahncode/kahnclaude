{
  "permissions": {
    "allow": [
      "Bash(date:*)",
      "Bash(mkdir:*)",
      "Bash(sort:*)",
      "Bash(tr:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git tag:*)",
      "mcp__context7__*",
      "mcp__claude_ai_Context7__*"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.dev)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(**/.env.staging)",
      "Read(**/.env.prod)",
      "Read(**/.env.production)",
      "Read(**/secrets/**)",
      "Read(**/secrets.*)",
      "Read(**/.secrets)",
      "Read(**/.secrets/**)",
      "Read(**/.secrets.*)",
      "Read(**/*credential*)",
      "Read(**/service-account*.json)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/.pgpass)",
      "Read(**/.my.cnf)",
      "Read(**/.git-credentials)",
      "Read(**/.netrc)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Read(**/id_dsa)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.docker/config.json)",
      "Edit(**/secrets/**)",
      "Edit(**/secrets.*)",
      "Edit(**/.secrets)",
      "Edit(**/.secrets/**)",
      "Edit(**/.secrets.*)",
      "Edit(**/*credential*)",
      "Edit(**/service-account*.json)",
      "Edit(**/.npmrc)",
      "Edit(**/.pypirc)",
      "Edit(**/.pgpass)",
      "Edit(**/.my.cnf)",
      "Edit(**/.git-credentials)",
      "Edit(**/.netrc)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/*.jks)",
      "Edit(**/*.keystore)",
      "Edit(**/id_rsa)",
      "Edit(**/id_ed25519)",
      "Edit(**/id_ecdsa)",
      "Edit(**/id_dsa)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.azure/**)",
      "Edit(~/.config/gcloud/**)",
      "Edit(~/.docker/config.json)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf ~/:*)",
      "Bash(rm -rf $HOME:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude/statusline.py"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/block-write-outside-repo.py"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/notify.py"
          }
        ]
      }
    ]
  }
}
